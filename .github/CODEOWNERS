# Who owns what. GitHub auto-requests a review from the owner when a PR
# touches their paths.
#
# Both people need push access or their entry is ignored silently — GitHub
# does not warn when it cannot resolve an owner.

# Default owner for anything not matched below.
*                       @mishahatescode

# ── UI / design / assets — Mac side ──────────────────────────────────────────
/lib/ui/                @mishahatescode
/lib/main.dart          @mishahatescode
/assets/                @mishahatescode

# ── Logic and tests — PC side ────────────────────────────────────────────────
/lib/core/              @LowTechPotato
/test/                  @LowTechPotato

# ── Release surface — Mac only, never touched from Windows ───────────────────
# Signing, provisioning and App Store Connect all require macOS.
/ios/                   @mishahatescode
/pubspec.yaml           @mishahatescode
/.github/workflows/     @mishahatescode
